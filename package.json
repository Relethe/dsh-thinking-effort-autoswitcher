{
  "name": "@local/thinking-effort",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "DSH thinking-effort auto-switcher: replaces the composer model picker, adds an Auto mode and shows the recorded effort of every turn.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "reasoning-effort",
    "model-picker"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "README.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Relethe/dsh-thinking-effort-autoswitcher.git"
  },
  "homepage": "https://github.com/Relethe/dsh-thinking-effort-autoswitcher#readme",
  "bugs": {
    "url": "https://github.com/Relethe/dsh-thinking-effort-autoswitcher/issues"
  }
}
